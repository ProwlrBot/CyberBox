{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mass_assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint", "body_format", "observed_fields", "candidate_privileged_fields", "framework_hints", "api_versions", "graphql_surfaces", "stop_conditions", "summary"],
  "properties": {
    "endpoint": { "type": "string", "minLength": 4, "maxLength": 400 },
    "body_format": {
      "type": "string",
      "enum": ["json", "form", "multipart", "graphql_mutation", "unknown"]
    },
    "observed_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "candidate_privileged_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "rationale", "test_value", "expected_blocked_signal", "proof_of_success"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 120 },
          "rationale": { "type": "string", "minLength": 8, "maxLength": 400 },
          "test_value": { "type": "string", "minLength": 1, "maxLength": 240 },
          "expected_blocked_signal": { "type": "string", "minLength": 4, "maxLength": 240 },
          "proof_of_success": { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      }
    },
    "framework_hints": {
      "type": "array",
      "items": { "type": "string", "minLength": 2, "maxLength": 300 }
    },
    "api_versions": {
      "type": "array",
      "items": { "type": "string", "minLength": 4, "maxLength": 300 }
    },
    "graphql_surfaces": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 6, "maxLength": 240 }
    },
    "summary": { "type": "string", "minLength": 8, "maxLength": 400 }
  }
}
