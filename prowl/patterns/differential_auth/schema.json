{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "differential_auth",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint", "feature", "actors", "comparison_matrix", "property_level_checks", "regression_triggers", "summary"],
  "properties": {
    "endpoint": { "type": "string", "minLength": 4, "maxLength": 400 },
    "feature": { "type": "string", "minLength": 8, "maxLength": 400 },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "session_context", "expected_access"],
        "properties": {
          "id":              { "type": "string", "minLength": 2, "maxLength": 80 },
          "role":            { "type": "string", "minLength": 2, "maxLength": 120 },
          "session_context": { "type": "string", "minLength": 4, "maxLength": 400 },
          "expected_access": { "type": "string", "enum": ["allow", "deny"] }
        }
      }
    },
    "comparison_matrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_a", "actor_b", "request", "actor_a_expected", "actor_b_expected", "oracle", "exploit_value"],
        "properties": {
          "actor_a":          { "type": "string", "minLength": 1, "maxLength": 80 },
          "actor_b":          { "type": "string", "minLength": 1, "maxLength": 80 },
          "request":          { "type": "string", "minLength": 6, "maxLength": 500 },
          "actor_a_expected": { "type": "string", "minLength": 4, "maxLength": 240 },
          "actor_b_expected": { "type": "string", "minLength": 4, "maxLength": 240 },
          "oracle":           { "type": "string", "minLength": 8, "maxLength": 400 },
          "exploit_value":    { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "property_level_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property", "actor_should_see", "actor_id", "test_request", "oracle"],
        "properties": {
          "property":        { "type": "string", "minLength": 1, "maxLength": 120 },
          "actor_should_see":{ "type": "string", "enum": ["allow", "deny"] },
          "actor_id":        { "type": "string", "minLength": 1, "maxLength": 80 },
          "test_request":    { "type": "string", "minLength": 6, "maxLength": 500 },
          "oracle":          { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      }
    },
    "regression_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 6, "maxLength": 300 }
    },
    "summary": { "type": "string", "minLength": 8, "maxLength": 400 }
  }
}
