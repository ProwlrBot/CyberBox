{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "file_upload_chain",
  "type": "object",
  "additionalProperties": false,
  "required": ["upload_endpoint", "storage_model", "content_type_checks", "filename_handling", "attack_vectors", "cross_user_retrieval", "async_processing", "stop_conditions", "summary"],
  "properties": {
    "upload_endpoint": { "type": "string", "minLength": 4, "maxLength": 400 },
    "storage_model": {
      "type": "string",
      "enum": ["same_origin", "cdn", "s3", "internal_path", "unknown"]
    },
    "content_type_checks": {
      "type": "string",
      "enum": ["none", "extension_only", "mime_only", "both", "unknown"]
    },
    "filename_handling": {
      "type": "string",
      "enum": ["preserved", "sanitized", "hashed", "unknown"]
    },
    "attack_vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "technique", "test_payload", "retrieval_url_pattern", "exploit_value", "cwe"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "technique": {
            "type": "string",
            "enum": [
              "stored_xss_svg",
              "stored_xss_html",
              "path_traversal_filename",
              "zip_slip",
              "ssrf_via_url_fetch",
              "polyglot_webshell",
              "mime_confusion",
              "content_sniff",
              "archive_bomb_check",
              "xxe_via_xml",
              "lfi_via_path"
            ]
          },
          "test_payload": { "type": "string", "minLength": 4, "maxLength": 1000 },
          "retrieval_url_pattern": { "type": "string", "minLength": 4, "maxLength": 400 },
          "exploit_value": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "cwe": {
            "type": "string",
            "enum": ["CWE-434", "CWE-22", "CWE-918", "CWE-611", "CWE-79", "CWE-400"]
          }
        }
      }
    },
    "cross_user_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testable", "method", "test_steps"],
      "properties": {
        "testable": { "type": "boolean" },
        "method": {
          "type": "string",
          "enum": ["direct_id", "predictable_path", "shared_namespace", "unknown"]
        },
        "test_steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      },
      "if": { "properties": { "testable": { "const": true } } },
      "then": { "properties": { "test_steps": { "minItems": 2 } } }
    },
    "async_processing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "trigger", "attack_note"],
        "properties": {
          "surface": { "type": "string", "minLength": 2, "maxLength": 120 },
          "trigger": { "type": "string", "minLength": 4, "maxLength": 240 },
          "attack_note": { "type": "string", "minLength": 8, "maxLength": 500 }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 6, "maxLength": 300 }
    },
    "summary": { "type": "string", "minLength": 8, "maxLength": 400 }
  }
}
