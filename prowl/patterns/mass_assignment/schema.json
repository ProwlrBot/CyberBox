{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mass_assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint", "framework_hint", "observed_body_fields", "response_fields", "candidate_fields", "nested_object_risk", "nested_object_note", "secondary_endpoints", "stop_conditions", "summary"],
  "properties": {
    "endpoint": { "type": "string", "minLength": 4, "maxLength": 400 },
    "framework_hint": {
      "type": "string",
      "enum": ["rails", "django", "laravel", "spring", "express", "fastapi", "unknown"]
    },
    "observed_body_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "response_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "candidate_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "source", "expected_effect", "request_mutation", "proof_of_acceptance", "proof_of_rejection", "exploit_value", "cwe"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 120 },
          "source": {
            "type": "string",
            "enum": ["response_leak", "api_schema", "sibling_endpoint", "common_pattern", "javascript_source"]
          },
          "expected_effect": { "type": "string", "minLength": 8, "maxLength": 400 },
          "request_mutation": { "type": "string", "minLength": 8, "maxLength": 500 },
          "proof_of_acceptance": { "type": "string", "minLength": 8, "maxLength": 400 },
          "proof_of_rejection": { "type": "string", "minLength": 8, "maxLength": 400 },
          "exploit_value": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "cwe": {
            "type": "string",
            "enum": ["CWE-915", "CWE-269", "CWE-284", "CWE-285"]
          }
        }
      }
    },
    "nested_object_risk": { "type": "string", "enum": ["none", "low", "medium", "high"] },
    "nested_object_note": { "type": "string", "minLength": 4, "maxLength": 240 },
    "secondary_endpoints": {
      "type": "array",
      "items": { "type": "string", "minLength": 6, "maxLength": 300 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 6, "maxLength": 300 }
    },
    "summary": { "type": "string", "minLength": 8, "maxLength": 400 }
  }
}
