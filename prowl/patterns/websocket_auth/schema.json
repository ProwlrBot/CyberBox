{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "websocket_auth",
  "type": "object",
  "additionalProperties": false,
  "required": ["upgrade_url", "auth_mechanism", "channel_model", "handshake_issues", "message_auth_tests", "reconnect_attack", "stop_conditions", "summary"],
  "properties": {
    "upgrade_url": { "type": "string", "minLength": 1, "maxLength": 400 },
    "auth_mechanism": {
      "type": "string",
      "enum": ["session_cookie", "bearer_token", "query_param_token", "none", "unknown"]
    },
    "channel_model": {
      "type": "string",
      "enum": ["user_private", "room_shared", "broadcast", "topic_subscription", "unknown"]
    },
    "handshake_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "evidence", "exploitation"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["token_in_query_string", "no_origin_check", "origin_wildcard", "no_auth_on_upgrade", "subprotocol_injection"]
          },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "evidence": { "type": "string", "minLength": 4, "maxLength": 240 },
          "exploitation": { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      }
    },
    "message_auth_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_name", "framing", "actor", "target_resource", "expected_blocked", "proof_of_bypass", "exploit_value"],
        "properties": {
          "test_name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "framing": { "type": "string", "minLength": 2, "maxLength": 500 },
          "actor": {
            "type": "string",
            "enum": ["Account_B", "anonymous", "lower_role", "expired_session"]
          },
          "target_resource": { "type": "string", "minLength": 2, "maxLength": 240 },
          "expected_blocked": { "type": "string", "minLength": 4, "maxLength": 240 },
          "proof_of_bypass": { "type": "string", "minLength": 8, "maxLength": 400 },
          "exploit_value": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "reconnect_attack": {
      "oneOf": [
        { "type": "string", "minLength": 8, "maxLength": 500 },
        { "type": "null" }
      ]
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 6, "maxLength": 240 }
    },
    "summary": { "type": "string", "minLength": 8, "maxLength": 400 }
  }
}
