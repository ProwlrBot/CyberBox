#!/usr/bin/env bash
# csbx — CyberSandbox plugin manager
# Homebrew-tap style: plugins are git repos with a csbx.yaml manifest
# Registry is a single YAML file in a GitHub repo
set -euo pipefail

# ── Config ───────────────────────────────────────────────────
CSBX_HOME="${CSBX_HOME:-$HOME/.csbx}"
CSBX_BIN="${CSBX_HOME}/bin"
CSBX_PLUGINS="${CSBX_HOME}/plugins"
CSBX_WORDLISTS="${CSBX_PLUGINS}/wordlists"
CSBX_TEMPLATES="${CSBX_PLUGINS}/nuclei-templates"
CSBX_REGISTRY_URL="${CSBX_REGISTRY_URL:-https://raw.githubusercontent.com/ProwlrBot/csbx-registry/main/registry.yaml}"
CSBX_REGISTRY="${CSBX_HOME}/registry.yaml"
CSBX_INSTALLED="${CSBX_HOME}/installed.yaml"
CSBX_REGISTRY_HELPER="${CSBX_REGISTRY_HELPER:-$(dirname "$0")/csbx-registry}"

# ── Colors ───────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; DIM='\033[0;90m'
BOLD='\033[1m'; NC='\033[0m'
if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
  RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; DIM=''; BOLD=''; NC=''
fi

info()  { echo -e "${CYAN}[+]${NC} $*"; }
ok()    { echo -e "${GREEN}[✓]${NC} $*"; }
warn()  { echo -e "${YELLOW}[!]${NC} $*"; }
err()   { echo -e "${RED}[x]${NC} $*" >&2; }

# ── Init ─────────────────────────────────────────────────────
ensure_dirs() {
  mkdir -p "$CSBX_BIN" "$CSBX_PLUGINS"/{tools,wordlists,nuclei-templates,themes,configs}
  [[ -f "$CSBX_INSTALLED" ]] || echo "plugins: {}" > "$CSBX_INSTALLED"

  # Ensure bin is on PATH
  if [[ ":$PATH:" != *":$CSBX_BIN:"* ]]; then
    export PATH="$CSBX_BIN:$PATH"
  fi
}

acquire_mutation_lock() {
  if command -v flock &>/dev/null; then
    exec 9>"${CSBX_HOME}/.mutation.lock"
    if ! flock -n 9; then
      err "Another csbx mutation is already running"
      return 1
    fi
  else
    local lock_dir="${CSBX_HOME}/.mutation.lock.d"
    if ! mkdir "$lock_dir" 2>/dev/null; then
      err "Another csbx mutation is already running (remove ${lock_dir} if it is stale)"
      return 1
    fi
    trap 'rmdir "${CSBX_HOME}/.mutation.lock.d" 2>/dev/null || true' EXIT
  fi
}

require_yaml() {
  if ! command -v python3 &>/dev/null || ! python3 -c "import yaml" 2>/dev/null; then
    err "PyYAML runtime dependency is missing"
    echo "  CyberBox image fix: rebuild with pyyaml included in /opt/venv" >&2
    echo "  Current container: ask an administrator to run:" >&2
    echo "    /opt/venv/bin/pip install pyyaml" >&2
    return 1
  fi
}

require_registry_helper() {
  if [[ ! -x "$CSBX_REGISTRY_HELPER" ]]; then
    err "csbx-registry helper is missing or not executable: $CSBX_REGISTRY_HELPER"
    return 1
  fi
}

registry_get() {
  CSBX_REGISTRY="$CSBX_REGISTRY" "$CSBX_REGISTRY_HELPER" get "$1" "$2" "$3"
}

registry_plan() {
  CSBX_REGISTRY="$CSBX_REGISTRY" "$CSBX_REGISTRY_HELPER" plan "$1" "$2"
}

# ── YAML helpers (safe — values via env vars, not string interpolation) ───
yaml_get() {
  local file="$1" key="$2"
  if command -v python3 &>/dev/null; then
    CSBX_YAML_FILE="$file" CSBX_YAML_KEY="$key" python3 - <<'PYEOF'
import yaml, os
try:
    with open(os.environ['CSBX_YAML_FILE']) as f:
        d = yaml.safe_load(f)
    for k in os.environ['CSBX_YAML_KEY'].split('.'):
        if d is None: break
        d = d.get(k) if isinstance(d, dict) else None
    print(d if d is not None else '')
except: print('')
PYEOF
  else
    grep "^  *${key}:" "$file" 2>/dev/null | head -1 | sed 's/.*: *//' | tr -d '"'
  fi
}

yaml_get_block() {
  local file="$1" key="$2"
  CSBX_YAML_FILE="$file" CSBX_YAML_KEY="$key" python3 - <<'PYEOF' 2>/dev/null || echo ""
import yaml, os
try:
    with open(os.environ['CSBX_YAML_FILE']) as f:
        d = yaml.safe_load(f)
    for k in os.environ['CSBX_YAML_KEY'].split('.'):
        if d is None: break
        d = d.get(k) if isinstance(d, dict) else None
    if d: print(d)
except: pass
PYEOF
}

yaml_list() {
  local file="$1" key="$2"
  CSBX_YAML_FILE="$file" CSBX_YAML_KEY="$key" python3 - <<'PYEOF' 2>/dev/null
import yaml, os
try:
    with open(os.environ['CSBX_YAML_FILE']) as f:
        d = yaml.safe_load(f)
    for k in os.environ['CSBX_YAML_KEY'].split('.'):
        if d is None: break
        d = d.get(k) if isinstance(d, dict) else None
    if isinstance(d, list):
        for item in d: print(item)
except: pass
PYEOF
}

installed_field() {
  local name="$1" field="$2"
  CSBX_INSTALLED="$CSBX_INSTALLED" CSBX_NAME="$name" CSBX_FIELD="$field" python3 - <<'PYEOF' 2>/dev/null
import os, yaml
with open(os.environ["CSBX_INSTALLED"], encoding="utf-8") as handle:
    data = yaml.safe_load(handle) or {}
value = data.get("plugins", {}).get(os.environ["CSBX_NAME"], {}).get(os.environ["CSBX_FIELD"], "")
print(value if value is not None else "")
PYEOF
}

record_install() {
  CSBX_INSTALLED="$CSBX_INSTALLED" python3 - <<'PYEOF'
import datetime, json, os, pathlib, tempfile, yaml
path = pathlib.Path(os.environ["CSBX_INSTALLED"])
with path.open(encoding="utf-8") as handle:
    data = yaml.safe_load(handle) or {}
record = json.loads(os.environ["CSBX_RECORD"])
record["installed_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
data.setdefault("plugins", {})[os.environ["CSBX_RECORD_NAME"]] = record
fd, temporary = tempfile.mkstemp(prefix="installed.", suffix=".yaml", dir=path.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        yaml.safe_dump(data, handle, default_flow_style=False, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PYEOF
}

remove_install_record() {
  CSBX_INSTALLED="$CSBX_INSTALLED" CSBX_NAME="$1" python3 - <<'PYEOF'
import os, pathlib, tempfile, yaml
path = pathlib.Path(os.environ["CSBX_INSTALLED"])
with path.open(encoding="utf-8") as handle:
    data = yaml.safe_load(handle) or {}
data.get("plugins", {}).pop(os.environ["CSBX_NAME"], None)
fd, temporary = tempfile.mkstemp(prefix="installed.", suffix=".yaml", dir=path.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        yaml.safe_dump(data, handle, default_flow_style=False, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PYEOF
}

# ── Name validation ──────────────────────────────────────────
validate_name() {
  local name="$1"
  if [[ "$name" =~ \.\.\/ ]] || [[ "$name" =~ [^a-zA-Z0-9._-] ]]; then
    err "Invalid plugin name: '${name}' — only alphanumeric, dot, dash, underscore allowed"
    return 1
  fi
}

# ── Install hook confirmation ────────────────────────────────
confirm_hook() {
  local label="$1" script="$2"
  if [[ "${CSBX_YES:-}" == "1" && "${CSBX_ACCEPT_HOOKS:-}" == "1" ]]; then
    return 0
  fi
  echo -e "${YELLOW}── ${label} hook script ──${NC}"
  echo "$script"
  echo -e "${YELLOW}── end ──${NC}"
  read -r -p "Run ${label} hook? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]]
}

confirm_action() {
  local prompt="$1"
  [[ "${CSBX_YES:-}" == "1" ]] && return 0
  read -r -p "${prompt} [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]]
}

require_non_root_install() {
  if [[ "$(id -u)" == "0" && "${CSBX_ALLOW_ROOT:-}" != "1" ]]; then
    err "Refusing to install plugins as root (set CSBX_ALLOW_ROOT=1 only inside a disposable installer sandbox)"
    return 1
  fi
}

safe_plugin_file() {
  local root="$1" relative="$2"
  [[ -n "$relative" && "$relative" != /* && "$relative" != *".."* ]] || return 1
  CSBX_SAFE_ROOT="$root" CSBX_SAFE_PATH="$relative" python3 - <<'PYEOF'
import os, pathlib, sys
root = pathlib.Path(os.environ["CSBX_SAFE_ROOT"]).resolve()
path = (root / os.environ["CSBX_SAFE_PATH"]).resolve()
try: path.relative_to(root)
except ValueError: sys.exit(1)
sys.exit(0 if path.is_file() else 1)
PYEOF
}

# ── Registry ─────────────────────────────────────────────────
registry_sync() {
  info "Syncing registry..."
  local tmp_registry
  tmp_registry=$(mktemp "${CSBX_HOME}/registry.XXXXXX")
  if curl -fsSL "$CSBX_REGISTRY_URL" -o "$tmp_registry" 2>/dev/null; then
    if CSBX_REGISTRY="$tmp_registry" "$CSBX_REGISTRY_HELPER" validate >/dev/null; then
      mv "$tmp_registry" "$CSBX_REGISTRY"
      ok "Registry synced and validated"
    else
      rm -f "$tmp_registry"
      err "Downloaded registry failed contract validation; cached registry was not changed"
      return 1
    fi
  else
    rm -f "$tmp_registry"
    warn "Failed to fetch registry — using cached copy"
    # Create a minimal registry if none exists
    if [[ ! -f "$CSBX_REGISTRY" ]]; then
      cat > "$CSBX_REGISTRY" <<'YAML'
version: 1
policy_version: "2026-04-25"
pdtm_tools: {}
caido_plugins: {}
plugins:
  seclists:
    repo: https://github.com/danielmiessler/SecLists
    type: wordlist
    description: "Discovery, fuzzing, and password lists"
    size: "1.2GB"
    tags: [recon, fuzzing, passwords]
  nuclei-templates:
    repo: https://github.com/projectdiscovery/nuclei-templates
    type: nuclei-templates
    description: "Official ProjectDiscovery nuclei templates"
    size: "180MB"
    tags: [scanning, cves]
  powerlevel10k:
    repo: https://github.com/romkatv/powerlevel10k
    type: theme
    description: "Zsh theme with instant prompt"
    size: "4MB"
    tags: [shell, theme, zsh]
  fuzzdb:
    repo: https://github.com/fuzzdb-project/fuzzdb
    type: wordlist
    description: "Attack patterns and payload lists"
    size: "60MB"
    tags: [fuzzing, payloads]
  onelistforall:
    repo: https://github.com/six2dez/OneListForAll
    type: wordlist
    description: "Merged wordlists for web fuzzing"
    size: "500MB"
    tags: [fuzzing, discovery]
  payloadsallthethings:
    repo: https://github.com/swisskyrepo/PayloadsAllTheThings
    type: wordlist
    description: "Payload lists for web app security"
    size: "200MB"
    tags: [payloads, injection, xss, sqli]
  assetnote-wordlists:
    repo: https://github.com/assetnote/wordlists
    type: wordlist
    description: "Assetnote automated wordlists"
    size: "2GB"
    tags: [recon, fuzzing, subdomains]
  gf-patterns:
    repo: https://github.com/1ndianl33t/Gf-Patterns
    type: config
    description: "GF patterns for bug bounty"
    size: "50KB"
    tags: [recon, patterns, gf]
  zsh-autosuggestions:
    repo: https://github.com/zsh-users/zsh-autosuggestions
    type: theme
    description: "Fish-like autosuggestions for zsh"
    size: "200KB"
    tags: [shell, zsh]
  zsh-syntax-highlighting:
    repo: https://github.com/zsh-users/zsh-syntax-highlighting
    type: theme
    description: "Syntax highlighting for zsh"
    size: "500KB"
    tags: [shell, zsh]
YAML
      ok "Created default registry"
    fi
  fi
}

# ── Search ───────────────────────────────────────────────────
cmd_search() {
  local query="${1:-}"
  [[ ! -f "$CSBX_REGISTRY" ]] && registry_sync

  CSBX_REGISTRY="$CSBX_REGISTRY" CSBX_QUERY="$query" python3 - <<'PYEOF' 2>/dev/null
import yaml, os
with open(os.environ['CSBX_REGISTRY']) as f:
    reg = yaml.safe_load(f)
query = os.environ.get('CSBX_QUERY', '').lower()
for section in ('plugins', 'pdtm_tools', 'caido_plugins'):
    for name, info in sorted((reg.get(section) or {}).items()):
        desc = info.get('description') or (f"Go tool from {info.get('repo','')}" if section == 'pdtm_tools' else '')
        searchable = f"{name} {desc} {' '.join(info.get('tags',[]))}".lower()
        if not query or query in searchable:
            typ = info.get('type', 'go-tool' if section == 'pdtm_tools' else '?')
            size = info.get('size','?')
            trust = 'strict' if section == 'caido_plugins' else ('pinned' if info.get('release') or info.get('commit') or (section == 'pdtm_tools' and info.get('version') != 'latest') else 'mutable')
            print(f'  \033[1m{name:25s}\033[0m {typ:20s} {size:>8s}  {trust:8s}  {desc[:52]}')
PYEOF
}

# ── Info ─────────────────────────────────────────────────────
cmd_info() {
  local name="$1"
  [[ ! -f "$CSBX_REGISTRY" ]] && registry_sync

  CSBX_REGISTRY="$CSBX_REGISTRY" CSBX_INSTALLED="$CSBX_INSTALLED" CSBX_NAME="$name" python3 - <<'PYEOF' 2>/dev/null
import yaml, os
name = os.environ['CSBX_NAME']
with open(os.environ['CSBX_REGISTRY']) as f:
    reg = yaml.safe_load(f)
p = None
section = ''
for candidate in ('plugins', 'pdtm_tools', 'caido_plugins'):
    if name in (reg.get(candidate) or {}):
        p, section = reg[candidate][name], candidate
        break
if not p:
    print(f'\033[31m[x]\033[0m Plugin "{name}" not in registry')
else:
    print(f"\033[1m {name} \033[0m")
    print(f"  Type:        {p.get('type','?')}")
    print(f"  Section:     {section}")
    print(f"  Description: {p.get('description','?')}")
    print(f"  Repo:        {p.get('repo','?')}")
    print(f"  Size:        {p.get('size','?')}")
    print(f"  Tags:        {', '.join(p.get('tags',[]))}")
    print(f"  Trust:       {'strict signed release' if section == 'caido_plugins' else 'standard'}")
    print(f"  Pinned:      {'yes' if p.get('release') or p.get('commit') or (section == 'pdtm_tools' and p.get('version') != 'latest') else 'no'}")

    installed_file = os.environ['CSBX_INSTALLED']
    if os.path.exists(installed_file):
        with open(installed_file) as f2:
            inst = yaml.safe_load(f2)
        if name in inst.get('plugins', {}):
            i = inst['plugins'][name]
            print(f"  \033[32mInstalled:\033[0m {i.get('installed_at','?')} at {i.get('path','?')}")
        else:
            print(f"  \033[33mNot installed\033[0m")
PYEOF
}

# ── Install ──────────────────────────────────────────────────
cmd_install() {
  local input="$1"
  local name="" repo_url="" plugin_type="" source_ref="" pin_kind="" registry_entry="false"

  # Determine if input is a name (from registry) or a URL
  if [[ "$input" == https://* || "$input" == git@* ]]; then
    repo_url="$input"
    name=$(basename "$repo_url" .git)
    validate_name "$name" || return 1
    warn "Installing unregistered plugin — review csbx.yaml before trusting"
    if ! confirm_action "Clone and inspect unregistered source ${repo_url}?"; then
      warn "Install cancelled"
      return 1
    fi
  elif [[ "$input" == http://* ]]; then
    err "Unregistered repositories must use HTTPS or an SSH Git remote"
    return 1
  else
    registry_entry="true"
    name="$input"
    validate_name "$name" || return 1
    [[ ! -f "$CSBX_REGISTRY" ]] && registry_sync
    repo_url=$(registry_get plugins "$name" repo 2>/dev/null || true)
    if [[ -z "$repo_url" ]]; then
      err "Plugin \"${name}\" not found in registry"
      echo "  Try: csbx search ${name}"
      echo "  Or:  csbx install https://github.com/user/repo"
      return 1
    fi
    plugin_type=$(registry_get plugins "$name" type)
    source_ref=$(registry_get plugins "$name" commit 2>/dev/null || true)
    if [[ -n "$source_ref" ]]; then
      pin_kind="commit"
    else
      source_ref=$(registry_get plugins "$name" release 2>/dev/null || true)
      [[ -n "$source_ref" ]] && pin_kind="release"
    fi
    if [[ -z "$source_ref" ]]; then
      warn "${name} is a mutable standard-tier entry; the registry does not pin a release or commit"
      if ! confirm_action "Install mutable source ${repo_url} at its current default branch?"; then
        warn "Install cancelled"
        return 1
      fi
    fi
  fi

  # Check if already installed
  if [[ -f "$CSBX_INSTALLED" ]] && CSBX_INSTALLED="$CSBX_INSTALLED" CSBX_NAME="$name" python3 - <<'PYEOF' 2>/dev/null
import yaml, os, sys
with open(os.environ['CSBX_INSTALLED']) as f:
    d = yaml.safe_load(f) or {}
sys.exit(0 if os.environ['CSBX_NAME'] in d.get('plugins', {}) else 1)
PYEOF
  then
    warn "${name} already installed. Use: csbx update ${name}"
    return 0
  fi

  info "Installing ${name} from ${repo_url}..."

  # Clone into a disposable staging directory. Commit pins are checked out by
  # object ID instead of being treated as branch names.
  local tmp_dir
  tmp_dir=$(mktemp -d)
  local clone_args=(--depth 1)
  if [[ "$pin_kind" == "release" ]]; then clone_args+=(--branch "$source_ref"); fi
  if ! git clone "${clone_args[@]}" "$repo_url" "$tmp_dir" 2>/dev/null; then
    err "Failed to clone ${repo_url}"
    rm -rf "$tmp_dir"
    return 1
  fi
  if [[ "$pin_kind" == "commit" ]]; then
    if ! git -C "$tmp_dir" fetch --depth 1 origin "$source_ref" >/dev/null 2>&1 ||
       ! git -C "$tmp_dir" checkout --detach "$source_ref" >/dev/null 2>&1; then
      err "Registry commit pin could not be checked out: ${source_ref}"
      rm -rf "$tmp_dir"
      return 1
    fi
  fi
  local resolved_commit
  resolved_commit=$(git -C "$tmp_dir" rev-parse HEAD 2>/dev/null || true)
  if [[ "$pin_kind" == "commit" && "$resolved_commit" != "$source_ref"* ]]; then
    err "Resolved commit does not match registry pin"
    rm -rf "$tmp_dir"
    return 1
  fi

  # Read manifest if present
  local manifest="${tmp_dir}/csbx.yaml"
  if [[ -f "$manifest" ]]; then
    plugin_type=$(yaml_get "$manifest" "type")
  fi
  plugin_type="${plugin_type:-tool}"
  if [[ ! "$plugin_type" =~ ^(tool|wordlist|nuclei-templates|yara-rules|sigma|threat-intel|theme|config)$ ]]; then
    err "Unsupported plugin type in manifest: ${plugin_type}"
    rm -rf "$tmp_dir"
    return 1
  fi

  # Run the build hook in staging. A failed hook never replaces an existing
  # plugin or produces an installed record.
  local target_dir="${CSBX_PLUGINS}/${plugin_type}/${name}"
  if [[ -f "${tmp_dir}/csbx.yaml" ]]; then
    local install_script
    install_script=$(yaml_get_block "${tmp_dir}/csbx.yaml" "install")
    if [[ -n "$install_script" && "$install_script" != "None" ]]; then
      if confirm_hook "install" "$install_script"; then
        info "Running install hook..."
        export CSBX_PLUGIN_DIR="$tmp_dir"
        export CSBX_WORDLISTS CSBX_TEMPLATES CSBX_BIN
        if ! (cd "$tmp_dir" && bash -c "$install_script"); then
          err "Install hook failed; no files were activated"
          rm -rf "$tmp_dir"
          return 1
        fi
      else
        err "Install hook was not approved; installation cancelled"
        rm -rf "$tmp_dir"
        return 1
      fi
    fi
  fi

  local binary
  if [[ -f "${tmp_dir}/csbx.yaml" ]]; then
    while IFS= read -r binary; do
      [[ -z "$binary" ]] && continue
      if ! safe_plugin_file "$tmp_dir" "$binary"; then
        err "Manifest binary path is unsafe or missing: ${binary}"
        rm -rf "$tmp_dir"
        return 1
      fi
      local destination="${CSBX_BIN}/$(basename "$binary")"
      if [[ -e "$destination" || -L "$destination" ]]; then
        err "Binary name collision: ${destination} already exists"
        rm -rf "$tmp_dir"
        return 1
      fi
    done < <(yaml_list "${tmp_dir}/csbx.yaml" "binaries")
  fi

  mkdir -p "$(dirname "$target_dir")"
  local backup=""
  if [[ -e "$target_dir" ]]; then
    backup="${target_dir}.backup.$(date +%s).$$"
    mv "$target_dir" "$backup"
  fi
  if ! mv "$tmp_dir" "$target_dir"; then
    [[ -n "$backup" ]] && mv "$backup" "$target_dir"
    err "Failed to activate plugin"
    return 1
  fi

  local linked=()
  if [[ -f "${target_dir}/csbx.yaml" ]]; then

    # Symlink binaries
    while IFS= read -r bin; do
      [[ -z "$bin" ]] && continue
      ln -sf "${target_dir}/${bin}" "${CSBX_BIN}/$(basename "$bin")"
      linked+=("${CSBX_BIN}/$(basename "$bin")")
      ok "Linked: $(basename "$bin")"
    done < <(yaml_list "${target_dir}/csbx.yaml" "binaries")

    # Post-install hook
    local post_script
    post_script=$(yaml_get_block "${target_dir}/csbx.yaml" "post_install")
    if [[ -n "$post_script" && "$post_script" != "None" ]]; then
      if confirm_hook "post_install" "$post_script"; then
        export CSBX_PLUGIN_DIR="$target_dir"
        if ! (cd "$target_dir" && bash -c "$post_script"); then
          err "post_install hook failed; restoring previous state"
          for binary in "${linked[@]}"; do rm -f "$binary"; done
          rm -rf "$target_dir"
          [[ -n "$backup" ]] && mv "$backup" "$target_dir"
          return 1
        fi
      else
        warn "post_install hook skipped; the plugin itself is installed"
      fi
    fi
  fi

  local record
  record=$(CSBX_TYPE="$plugin_type" CSBX_REPO="$repo_url" CSBX_TARGET="$target_dir" \
    CSBX_REF="$source_ref" CSBX_COMMIT="$resolved_commit" CSBX_REGISTERED="$registry_entry" python3 - <<'PYEOF'
import json, os
print(json.dumps({
    "type": os.environ["CSBX_TYPE"], "repo": os.environ["CSBX_REPO"],
    "path": os.environ["CSBX_TARGET"], "source": "registry" if os.environ["CSBX_REGISTERED"] == "true" else "direct",
    "source_ref": os.environ["CSBX_REF"], "resolved_commit": os.environ["CSBX_COMMIT"],
    "mutable_source": not bool(os.environ["CSBX_REF"]),
}))
PYEOF
)
  if ! CSBX_RECORD_NAME="$name" CSBX_RECORD="$record" record_install; then
    err "Could not record installation; restoring previous state"
    for binary in "${linked[@]}"; do rm -f "$binary"; done
    rm -rf "$target_dir"
    [[ -n "$backup" ]] && mv "$backup" "$target_dir"
    return 1
  fi
  [[ -n "$backup" ]] && rm -rf "$backup"

  ok "${name} installed → ${target_dir}"
}

# ── Remove ───────────────────────────────────────────────────
cmd_remove() {
  local name="$1"
  validate_name "$name" || return 1

  # Find installed path
  local path
  path=$(CSBX_INSTALLED="$CSBX_INSTALLED" CSBX_NAME="$name" python3 - <<'PYEOF' 2>/dev/null
import yaml, os
with open(os.environ['CSBX_INSTALLED']) as f:
    d = yaml.safe_load(f) or {}
p = d.get('plugins', {}).get(os.environ['CSBX_NAME'], {})
print(p.get('path', ''))
PYEOF
)

  if [[ -z "$path" || ! -d "$path" ]]; then
    err "${name} is not installed"
    return 1
  fi
  local real_path real_plugins real_caido
  real_path=$(realpath "$path")
  real_plugins=$(realpath "$CSBX_PLUGINS")
  real_caido=$(realpath -m "${CAIDO_PLUGIN_HOME:-$HOME/.caido/plugins}")
  if [[ "$real_path" != "$real_plugins"/* && "$real_path" != "$real_caido"/* ]]; then
    err "Refusing to remove path outside managed plugin roots: ${path}"
    return 1
  fi

  # Run uninstall hook
  if [[ -f "${path}/csbx.yaml" ]]; then
    local uninstall_script
    uninstall_script=$(yaml_get_block "${path}/csbx.yaml" "uninstall")
    if [[ -n "$uninstall_script" && "$uninstall_script" != "None" ]]; then
      if confirm_hook "uninstall" "$uninstall_script"; then
        info "Running uninstall hook..."
        export CSBX_PLUGIN_DIR="$path"
        export CSBX_WORDLISTS CSBX_TEMPLATES CSBX_BIN
        (cd "$path" && bash -c "$uninstall_script") || true
      else
        warn "uninstall hook skipped"
      fi
    fi

    # Remove binary symlinks
    while IFS= read -r bin; do
      [[ -z "$bin" ]] && continue
      local link="${CSBX_BIN}/$(basename "$bin")"
      if [[ -L "$link" && "$(realpath "$link" 2>/dev/null || true)" == "$real_path"/* ]]; then
        rm -f "$link"
      fi
    done < <(yaml_list "${path}/csbx.yaml" "binaries")
  fi

  # Delete plugin directory
  rm -rf "$path"

  remove_install_record "$name"

  ok "${name} removed"
}

# ── Update ───────────────────────────────────────────────────
cmd_update() {
  local name="$1"

  if [[ "$name" == "--all" ]]; then
    local plugins
    plugins=$(CSBX_INSTALLED="$CSBX_INSTALLED" python3 - <<'PYEOF' 2>/dev/null
import yaml, os
with open(os.environ['CSBX_INSTALLED']) as f:
    d = yaml.safe_load(f) or {}
for name in d.get('plugins', {}):
    print(name)
PYEOF
)
    while IFS= read -r plugin; do
      [[ -z "$plugin" ]] && continue
      cmd_update "$plugin"
    done <<< "$plugins"
    return
  fi

  validate_name "$name" || return 1

  local path
  path=$(installed_field "$name" path)

  if [[ -z "$path" || ! -d "$path" ]]; then
    err "${name} is not installed"
    return 1
  fi

  local source type source_ref
  source=$(installed_field "$name" source)
  type=$(installed_field "$name" type)
  source_ref=$(installed_field "$name" source_ref)
  if [[ "$source" == "pdtm" ]]; then cmd_pdtm "$name"; return; fi
  if [[ "$type" == "caido-plugin" ]]; then cmd_caido install "$name"; return; fi

  if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
    err "${name} has local changes; refusing to overwrite them"
    return 1
  fi
  local previous_commit
  previous_commit=$(git -C "$path" rev-parse HEAD 2>/dev/null || true)
  info "Updating ${name}..."
  local updated=false
  if [[ -n "$source_ref" ]]; then
    [[ ! -f "$CSBX_REGISTRY" ]] && registry_sync
    local registry_ref registry_commit
    registry_commit=$(registry_get plugins "$name" commit 2>/dev/null || true)
    registry_ref="$registry_commit"
    [[ -z "$registry_ref" ]] && registry_ref=$(registry_get plugins "$name" release 2>/dev/null || true)
    if [[ -z "$registry_ref" ]]; then
      err "Installed plugin is pinned, but its registry entry no longer has a pin"
      return 1
    fi
    if git -C "$path" fetch --depth 1 origin "$registry_ref" >/dev/null 2>&1 &&
       git -C "$path" checkout --detach FETCH_HEAD >/dev/null 2>&1; then
      local candidate_commit
      candidate_commit=$(git -C "$path" rev-parse HEAD 2>/dev/null || true)
      if [[ -n "$registry_commit" && "$candidate_commit" != "$registry_commit"* ]]; then
        err "Fetched commit does not match the registry pin; restoring ${previous_commit}"
        git -C "$path" checkout --detach "$previous_commit" >/dev/null 2>&1 || true
        return 1
      fi
      updated=true
      source_ref="$registry_ref"
    fi
  elif git -C "$path" pull --ff-only 2>/dev/null; then
    updated=true
  fi
  if [[ "$updated" == "true" ]]; then
    # Re-run install hook if manifest exists
    if [[ -f "${path}/csbx.yaml" ]]; then
      local install_script
      install_script=$(yaml_get_block "${path}/csbx.yaml" "install")
      if [[ -n "$install_script" && "$install_script" != "None" ]]; then
        if confirm_hook "install" "$install_script"; then
          export CSBX_PLUGIN_DIR="$path"
          if ! (cd "$path" && bash -c "$install_script"); then
            err "Install hook failed; restoring ${previous_commit}"
            git -C "$path" checkout --detach "$previous_commit" >/dev/null 2>&1 || true
            return 1
          fi
        else
          warn "install hook skipped"
        fi
      fi
    fi
    local new_commit record
    new_commit=$(git -C "$path" rev-parse HEAD)
    record=$(CSBX_TYPE="$type" CSBX_REPO="$(installed_field "$name" repo)" CSBX_TARGET="$path" \
      CSBX_SOURCE="$source" CSBX_REF="$source_ref" CSBX_COMMIT="$new_commit" python3 - <<'PYEOF'
import json, os
print(json.dumps({
    "type": os.environ["CSBX_TYPE"], "repo": os.environ["CSBX_REPO"], "path": os.environ["CSBX_TARGET"],
    "source": os.environ["CSBX_SOURCE"], "source_ref": os.environ["CSBX_REF"],
    "resolved_commit": os.environ["CSBX_COMMIT"], "mutable_source": not bool(os.environ["CSBX_REF"]),
}))
PYEOF
)
    CSBX_RECORD_NAME="$name" CSBX_RECORD="$record" record_install
    ok "${name} updated → ${new_commit:0:12}"
  else
    err "${name} update failed; existing checkout was left unchanged"
    return 1
  fi
}

# ── List ─────────────────────────────────────────────────────
cmd_list() {
  if [[ "${1:-}" == "--available" ]]; then
    echo -e "${BOLD}Available plugins:${NC}"
    cmd_search ""
    return
  fi

  echo -e "${BOLD}Installed plugins:${NC}"
  if [[ ! -f "$CSBX_INSTALLED" ]]; then
    echo "  (none)"
    return
  fi

  CSBX_INSTALLED="$CSBX_INSTALLED" python3 - <<'PYEOF' 2>/dev/null
import yaml, os
with open(os.environ['CSBX_INSTALLED']) as f:
    d = yaml.safe_load(f) or {}
plugins = d.get('plugins', {})
if not plugins:
    print('  (none — try: csbx install seclists)')
for name, info in sorted(plugins.items()):
    typ = info.get('type','?')
    path = info.get('path','?')
    print(f'  \033[1m{name:25s}\033[0m {typ:20s} {path}')
PYEOF
}

# ── Doctor ───────────────────────────────────────────────────
cmd_doctor() {
  echo -e "${BOLD}CyberSandbox Health Check${NC}"
  echo ""

  # Check dirs
  for dir in "$CSBX_HOME" "$CSBX_BIN" "$CSBX_PLUGINS"; do
    if [[ -d "$dir" ]]; then
      ok "$dir"
    else
      warn "$dir missing"
    fi
  done

  # Check broken symlinks in bin
  local broken=0
  for link in "$CSBX_BIN"/*; do
    [[ -e "$link" ]] && continue
    [[ -L "$link" ]] || continue
    warn "Broken symlink: $link"
    broken=$((broken + 1))
  done
  [[ $broken -eq 0 ]] && ok "No broken symlinks"

  # Check python3 + yaml
  if python3 -c "import yaml" 2>/dev/null; then
    ok "python3 + pyyaml available"
  else
    err "python3 or pyyaml missing — csbx needs it"
    echo "  Fix as container root: /opt/venv/bin/pip install pyyaml"
  fi

  # Check git
  if command -v git &>/dev/null; then
    ok "git available"
  else
    err "git missing"
  fi

  # Show stats
  echo ""
  local count
  count=$(CSBX_INSTALLED="$CSBX_INSTALLED" python3 - <<'PYEOF' 2>/dev/null || echo "0"
import yaml, os
with open(os.environ['CSBX_INSTALLED']) as f:
    d = yaml.safe_load(f) or {}
print(len(d.get('plugins', {})))
PYEOF
)
  info "${count} plugin(s) installed"

  local size
  size=$(du -sh "$CSBX_PLUGINS" 2>/dev/null | cut -f1)
  info "Plugin storage: ${size:-0}"
}

# ── Main ─────────────────────────────────────────────────────
# ── pdtm-format install ──────────────────────────────────────
# Accepts a manifest shaped like projectdiscovery/pdtm tool entries:
#   name: subfinder
#   repo: projectdiscovery/subfinder
#   install_type: go       # or "binary"
#   go_install_path: github.com/projectdiscovery/subfinder/v2/cmd/subfinder
#   version: latest
#
# Usage: csbx pdtm <manifest.yaml> | <repo:tool> | <go-install-path>
cmd_pdtm() {
  local input="$1"
  local name repo install_type go_path version

  if [[ -f "$input" ]]; then
    # Manifest file
    name=$(yaml_get "$input" "name")
    repo=$(yaml_get "$input" "repo")
    install_type=$(yaml_get "$input" "install_type")
    go_path=$(yaml_get "$input" "go_install_path")
    version=$(yaml_get "$input" "version")
  elif [[ "$input" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    [[ ! -f "$CSBX_REGISTRY" ]] && registry_sync
    name="$input"
    repo=$(registry_get pdtm_tools "$name" repo)
    install_type=$(registry_get pdtm_tools "$name" install_type)
    go_path=$(registry_get pdtm_tools "$name" go_install_path)
    version=$(registry_get pdtm_tools "$name" version)
  elif [[ "$input" == *"/"*"/"* ]] || [[ "$input" == "github.com/"* ]]; then
    # Raw go install path
    go_path="$input"
    name=$(basename "$go_path")
    install_type="go"
    version="latest"
  else
    err "Need a manifest file or a Go install path (e.g. github.com/org/tool/cmd/tool)"
    return 1
  fi

  validate_name "$name" || return 1
  install_type="${install_type:-go}"
  version="${version:-latest}"
  if [[ "$go_path" == *@* ]]; then
    version="${go_path##*@}"
    go_path="${go_path%@*}"
  fi
  if [[ "$version" == "latest" ]]; then
    warn "${name} resolves to @latest and is not reproducible; the installed module version will be recorded"
  fi

  case "$install_type" in
    go)
      if ! command -v go &>/dev/null; then
        err "Go toolchain required for install_type=go"
        return 1
      fi
      if [[ -z "$go_path" ]]; then
        err "install_type=go requires go_install_path"
        return 1
      fi
      info "Installing ${name} via: go install ${go_path}@${version}"
      local go_stage
      go_stage=$(mktemp -d)
      if ! GOBIN="$go_stage" go install "${go_path}@${version}"; then
        rm -rf "$go_stage"
        err "go install failed"
        return 1
      fi
      local built_binary="${go_stage}/${name}"
      if [[ ! -f "$built_binary" ]]; then
        local built_files=("${go_stage}"/*)
        if [[ ${#built_files[@]} -ne 1 || ! -f "${built_files[0]}" ]]; then
          rm -rf "$go_stage"
          err "go install did not produce one executable"
          return 1
        fi
        built_binary="${built_files[0]}"
      fi
      local binary_backup=""
      if [[ -e "${CSBX_BIN}/${name}" || -L "${CSBX_BIN}/${name}" ]]; then
        binary_backup="${go_stage}/previous"
        mv "${CSBX_BIN}/${name}" "$binary_backup"
      fi
      if ! mv "$built_binary" "${CSBX_BIN}/${name}"; then
        [[ -n "$binary_backup" ]] && mv "$binary_backup" "${CSBX_BIN}/${name}"
        rm -rf "$go_stage"
        err "Could not activate ${name}"
        return 1
      fi
      ;;
    binary)
      err "install_type=binary not yet implemented — use a csbx.yaml install script"
      return 1
      ;;
    *)
      err "Unknown install_type: $install_type"
      return 1
      ;;
  esac

  local record
  record=$(CSBX_REPO="${repo:-${go_path%%/cmd*}}" CSBX_TARGET="${CSBX_BIN}/${name}" \
    CSBX_VERSION="$version" CSBX_GO_PATH="$go_path" python3 - <<'PYEOF'
import json, os
print(json.dumps({"type": "tool", "source": "pdtm", "repo": os.environ["CSBX_REPO"],
                  "path": os.environ["CSBX_TARGET"], "version": os.environ["CSBX_VERSION"],
                  "go_install_path": os.environ["CSBX_GO_PATH"], "mutable_source": os.environ["CSBX_VERSION"] == "latest"}))
PYEOF
)
  if ! CSBX_RECORD_NAME="$name" CSBX_RECORD="$record" record_install; then
    rm -f "${CSBX_BIN}/${name}"
    [[ -n "${binary_backup:-}" && -e "$binary_backup" ]] && mv "$binary_backup" "${CSBX_BIN}/${name}"
    [[ -n "${go_stage:-}" ]] && rm -rf "$go_stage"
    err "Could not record PDTM install; previous binary restored"
    return 1
  fi
  [[ -n "${go_stage:-}" ]] && rm -rf "$go_stage"

  ok "${name} installed → ${CSBX_BIN}/${name}"
}

cmd_plan() {
  local section="plugins" name="${1:?Usage: csbx plan [--pdtm|--caido] <name>}"
  if [[ "$name" == "--pdtm" ]]; then section="pdtm_tools"; name="${2:?missing name}"; fi
  if [[ "$name" == "--caido" ]]; then section="caido_plugins"; name="${2:?missing name}"; fi
  [[ ! -f "$CSBX_REGISTRY" ]] && registry_sync
  registry_plan "$section" "$name"
}

cmd_caido() {
  local operation="$1" name="$2"
  validate_name "$name" || return 1
  [[ ! -f "$CSBX_REGISTRY" ]] && registry_sync
  local manifest release target_dir temporary artifact stage verification
  manifest=$(registry_get caido_plugins "$name" manifest)
  release=$(registry_get caido_plugins "$name" release)
  temporary=$(mktemp -d)
  artifact="${temporary}/plugin.zip"
  if ! verification=$(CSBX_REGISTRY="$CSBX_REGISTRY" "$CSBX_REGISTRY_HELPER" verify-caido "$name" --output "$artifact"); then
    rm -rf "$temporary"
    return 1
  fi
  echo "$verification"
  if [[ "$operation" == "verify" ]]; then
    rm -rf "$temporary"
    ok "${name}@${release} signature verified"
    return 0
  fi
  if ! confirm_action "Install verified ${name}@${release} into ~/.caido/plugins/${name}?"; then
    rm -rf "$temporary"
    warn "Install cancelled"
    return 1
  fi
  stage="${temporary}/stage"
  local extract_json plugin_root
  if ! extract_json=$(CSBX_REGISTRY="$CSBX_REGISTRY" "$CSBX_REGISTRY_HELPER" extract-caido "$artifact" "$stage" "$manifest"); then
    rm -rf "$temporary"
    return 1
  fi
  plugin_root=$(CSBX_EXTRACT_JSON="$extract_json" python3 - <<'PYEOF'
import json, os
print(json.loads(os.environ["CSBX_EXTRACT_JSON"])["plugin_root"])
PYEOF
)
  [[ "$plugin_root" == "$stage" || "$plugin_root" == "$stage"/* ]] || {
    rm -rf "$temporary"; err "Extractor returned an unsafe plugin root"; return 1;
  }
  target_dir="${CAIDO_PLUGIN_HOME:-$HOME/.caido/plugins}/${name}"
  mkdir -p "$(dirname "$target_dir")"
  local backup=""
  if [[ -e "$target_dir" ]]; then backup="${target_dir}.backup.$(date +%s)"; mv "$target_dir" "$backup"; fi
  if ! mv "$plugin_root" "$target_dir"; then
    [[ -n "$backup" ]] && mv "$backup" "$target_dir"
    rm -rf "$temporary"
    err "Failed to activate ${name}; previous version restored"
    return 1
  fi
  local record
  record=$(CSBX_TARGET="$target_dir" CSBX_RELEASE="$release" CSBX_VERIFY_JSON="$verification" python3 - <<'PYEOF'
import json, os
verified = json.loads(os.environ["CSBX_VERIFY_JSON"])
print(json.dumps({"type": "caido-plugin", "source": "signed-release",
                  "version": os.environ["CSBX_RELEASE"], "path": os.environ["CSBX_TARGET"],
                  "sha256": verified["sha256"], "signature": verified["signature_method"],
                  "mutable_source": False}))
PYEOF
)
  if ! CSBX_RECORD_NAME="$name" CSBX_RECORD="$record" record_install; then
    rm -rf "$target_dir"
    [[ -n "$backup" ]] && mv "$backup" "$target_dir"
    rm -rf "$temporary"
    err "Could not record signed plugin; previous version restored"
    return 1
  fi
  [[ -n "$backup" ]] && rm -rf "$backup"
  rm -rf "$temporary"
  ok "${name}@${release} installed → ${target_dir}"
}

# ── Verify (supply-chain) ────────────────────────────────────
# Mirrors the `verify-supply-chain` job in
# .github/workflows/cybersandbox-build.yml so a hunter can prove a locally
# pulled image matches what CyberBox actually published — without having to
# memorise cosign syntax. Shells out to cosign (keyless) + docker buildx for
# SBOM inspection. Identity regex is pinned to the build workflow so a swap
# to a different signer trips the check.
CSBX_VERIFY_DEFAULT_IMAGE="${CSBX_VERIFY_IMAGE:-ghcr.io/prowlrbot/cybersandbox}"
CSBX_VERIFY_DEFAULT_TAG="${CSBX_VERIFY_TAG:-latest}"
CSBX_VERIFY_IDENTITY_REGEX="${CSBX_VERIFY_IDENTITY_REGEX:-^https://github.com/ProwlrBot/CyberBox/.github/workflows/cybersandbox-build.yml@refs/}"
CSBX_VERIFY_OIDC_ISSUER="${CSBX_VERIFY_OIDC_ISSUER:-https://token.actions.githubusercontent.com}"
CSBX_VERIFY_REKOR_URL="${CSBX_VERIFY_REKOR_URL:-https://rekor.sigstore.dev}"

# verify_resolve_digest <ref>
# Echoes the manifest digest for a tag or @digest reference. Prefers
# `docker buildx imagetools inspect` (no pull required) and falls back to
# `cosign triangulate` then `docker inspect` on a pulled image.
verify_resolve_digest() {
  local ref="$1" digest=""

  if [[ "$ref" == *"@sha256:"* ]]; then
    echo "${ref##*@}"
    return 0
  fi

  if command -v docker &>/dev/null; then
    digest=$(docker buildx imagetools inspect "$ref" --format '{{ .Manifest.Digest }}' 2>/dev/null || true)
    if [[ -n "$digest" ]]; then
      echo "$digest"
      return 0
    fi
    # Fall back to a local pull's RepoDigests
    digest=$(docker image inspect "$ref" --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null \
      | awk -F'@' 'NF==2 {print $2; exit}')
    if [[ -n "$digest" ]]; then
      echo "$digest"
      return 0
    fi
  fi

  return 1
}

# verify_extract_rekor_url <verify-output-file>
# Pulls the first Rekor entry URL out of cosign verify JSON output.
verify_extract_rekor_url() {
  local file="$1"
  CSBX_VERIFY_FILE="$file" CSBX_VERIFY_REKOR_URL="$CSBX_VERIFY_REKOR_URL" python3 - <<'PYEOF' 2>/dev/null || true
import json, os, sys
try:
    with open(os.environ['CSBX_VERIFY_FILE']) as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
base = os.environ.get('CSBX_VERIFY_REKOR_URL', 'https://rekor.sigstore.dev').rstrip('/')
entries = data if isinstance(data, list) else [data]
for e in entries:
    log_idx = (
        (((e.get('optional') or {}).get('Bundle') or {}).get('Payload') or {}).get('logIndex')
        or (e.get('rekorBundle') or {}).get('Payload', {}).get('logIndex')
    )
    if log_idx is not None:
        print(f"{base}/api/v1/log/entries?logIndex={log_idx}")
        break
PYEOF
}

# verify_extract_fulcio_url <verify-output-file>
verify_extract_fulcio_url() {
  local file="$1"
  CSBX_VERIFY_FILE="$file" python3 - <<'PYEOF' 2>/dev/null || true
import json, os, sys
try:
    with open(os.environ['CSBX_VERIFY_FILE']) as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
entries = data if isinstance(data, list) else [data]
for e in entries:
    opt = (e.get('optional') or {})
    sub = opt.get('Subject') or opt.get('subject')
    if sub:
        print(sub)
        break
    crit = (e.get('critical') or {}).get('identity') or {}
    if crit.get('docker-reference'):
        print(crit['docker-reference'])
        break
PYEOF
}

cmd_verify() {
  local image="$CSBX_VERIFY_DEFAULT_IMAGE"
  local tag="$CSBX_VERIFY_DEFAULT_TAG"
  local explicit_ref=""
  local skip_sbom=0
  local skip_rekor=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --image)        image="${2:?--image needs a value}"; shift 2 ;;
      --tag)          tag="${2:?--tag needs a value}"; shift 2 ;;
      --ref)          explicit_ref="${2:?--ref needs a value}"; shift 2 ;;
      --identity)     CSBX_VERIFY_IDENTITY_REGEX="${2:?--identity needs a value}"; shift 2 ;;
      --oidc-issuer)  CSBX_VERIFY_OIDC_ISSUER="${2:?--oidc-issuer needs a value}"; shift 2 ;;
      --skip-sbom)    skip_sbom=1; shift ;;
      --skip-rekor)   skip_rekor=1; shift ;;
      -h|--help)
        cat <<'HELP'
csbx verify — supply-chain verifier for cybersandbox images

Runs the same cosign keyless signature check, SBOM presence inspection, and
Rekor transparency-log lookup that the CI verify-supply-chain job runs, against
any locally pulled cybersandbox image.

USAGE:
  csbx verify [--image <repo>] [--tag <tag>] [--ref <repo:tag|repo@sha256:...>]
              [--identity <regex>] [--oidc-issuer <url>]
              [--skip-sbom] [--skip-rekor]

DEFAULTS:
  --image  ghcr.io/prowlrbot/cybersandbox
  --tag    latest

EXAMPLES:
  csbx verify
  csbx verify --tag sha-abc1234
  csbx verify --ref ghcr.io/prowlrbot/cybersandbox@sha256:deadbeef...

EXIT:
  0  signed, transparency-logged, SBOM present
  1  unsigned / tampered / verification failed
  2  prerequisites missing (cosign, docker)

UNDERLYING COMMAND (audit the wrapper):
  cosign verify <image>@<digest> \
    --certificate-identity-regexp '^https://github.com/ProwlrBot/CyberBox/.github/workflows/cybersandbox-build.yml@refs/' \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com
HELP
        return 0
        ;;
      *)
        err "Unknown verify flag: $1"
        echo "Try: csbx verify --help" >&2
        return 2
        ;;
    esac
  done

  # Prerequisites
  if ! command -v cosign &>/dev/null; then
    err "cosign not found in PATH — install from https://docs.sigstore.dev/cosign/installation/"
    return 2
  fi
  if ! command -v docker &>/dev/null; then
    err "docker not found in PATH — needed to resolve image digests + inspect SBOM"
    return 2
  fi

  local ref="${explicit_ref:-${image}:${tag}}"
  local repo="${ref%@*}"
  repo="${repo%:*}"

  info "Verifying ${ref}"

  # 1) Resolve digest
  local digest
  if ! digest=$(verify_resolve_digest "$ref"); then
    err "Could not resolve digest for ${ref}"
    echo "  Try: docker pull ${ref}" >&2
    echo "  Or:  csbx verify --ref ${repo}@sha256:<digest>" >&2
    return 1
  fi
  ok "Resolved digest: ${digest}"

  # 2) cosign verify (keyless / Fulcio / Rekor)
  local pinned="${repo}@${digest}"
  local verify_out
  verify_out=$(mktemp)
  trap 'rm -f "$verify_out"' RETURN

  info "Running cosign verify (keyless)"
  if ! cosign verify "${pinned}" \
        --certificate-identity-regexp "${CSBX_VERIFY_IDENTITY_REGEX}" \
        --certificate-oidc-issuer "${CSBX_VERIFY_OIDC_ISSUER}" \
        > "$verify_out" 2>&1; then
    err "Signature verification FAILED for ${pinned}"
    echo "" >&2
    sed 's/^/    /' "$verify_out" >&2
    echo "" >&2
    echo "  Possible causes:" >&2
    echo "    - image was published before keyless signing was enabled" >&2
    echo "    - tag points at a tampered/unsigned digest (refuse to use it)" >&2
    echo "    - identity regex does not match — verify the build workflow URL" >&2
    return 1
  fi
  ok "cosign signature: VALID"

  local fulcio_subject rekor_url
  fulcio_subject=$(verify_extract_fulcio_url "$verify_out")
  rekor_url=$(verify_extract_rekor_url "$verify_out")

  # 3) SBOM presence (buildx attaches as OCI referrer)
  if [[ "$skip_sbom" -eq 0 ]]; then
    info "Inspecting SBOM"
    local sbom
    sbom=$(mktemp)
    if docker buildx imagetools inspect "${pinned}" --format '{{ json .SBOM }}' > "$sbom" 2>/dev/null; then
      local bytes
      bytes=$(wc -c < "$sbom" | tr -d ' ')
      if [[ "$bytes" -lt 64 ]]; then
        err "SBOM payload suspiciously small (${bytes} bytes)"
        rm -f "$sbom"
        return 1
      fi
      if ! grep -q -E '"SPDXID"|"spdxVersion"|"bomFormat"' "$sbom"; then
        err "SBOM does not contain SPDX or CycloneDX markers"
        rm -f "$sbom"
        return 1
      fi
      ok "SBOM present (${bytes} bytes, SPDX/CycloneDX)"
      rm -f "$sbom"
    else
      warn "Could not fetch SBOM via 'docker buildx imagetools inspect' — skipping (use --skip-sbom to silence)"
    fi
  fi

  # 4) Rekor entry presence (best-effort: cosign already hit Rekor above,
  # but expose the URL so a hunter can browse the transparency log).
  echo ""
  echo -e "${BOLD}Supply-chain verification: PASS${NC}"
  echo "  image:   ${repo}"
  echo "  digest:  ${digest}"
  [[ -n "$fulcio_subject" ]] && echo "  signer:  ${fulcio_subject}"
  if [[ -n "$rekor_url" && "$skip_rekor" -eq 0 ]]; then
    echo "  rekor:   ${rekor_url}"
  fi
  echo "  fulcio:  https://search.sigstore.dev/?hash=${digest#sha256:}"
  echo ""
  return 0
}

usage() {
  cat <<'EOF'
csbx — CyberSandbox Plugin Manager

COMMANDS:
  search [query]        Search available plugins
  info <plugin>         Show plugin details
  install <plugin>      Install from registry
  install --caido <id>  Verify and install a signed Caido release
  install <git-url>     Install from any git URL
  remove <plugin>       Uninstall a plugin
  update <plugin>       Update without overwriting local changes
  update --all          Update all plugins
  list                  List installed plugins
  list --available      List all registry plugins
  sync                  Force re-fetch registry
  pdtm <name|path>      Install a named registry tool or Go module path
  plan [flags] <name>   Print the resolved install plan without changing state
  verify-plugin --caido <id>
                        Download and verify a signed Caido release
  verify-image [flags]  Verify image signature, SBOM, and Rekor entry
  verify [flags]        Compatibility alias for verify-image
  doctor                Health check

PLUGIN TYPES:
  tool                  Binaries (Go, Rust, Python tools)
  wordlist              Wordlists (SecLists, PayloadsAllTheThings, etc)
  nuclei-templates      Nuclei template collections
  theme                 Shell themes (p10k, zsh plugins)
  config                Config files (gf patterns, etc)

EXAMPLES:
  csbx install seclists
  csbx install payloadsallthethings
  csbx pdtm subfinder
  csbx plan --pdtm nuclei
  csbx install https://github.com/someone/custom-tool
  csbx search xss
  csbx list
  csbx update --all

ENVIRONMENT:
  CSBX_HOME             Plugin root (default: ~/.csbx)
  CSBX_REGISTRY_URL     Registry URL (default: ProwlrBot/csbx-registry)
  CSBX_YES=1            Accept non-hook confirmations
  CSBX_ACCEPT_HOOKS=1   With CSBX_YES=1, approve displayed hooks
  CAIDO_PLUGIN_HOME     Caido plugin directory (default: ~/.caido/plugins)
  NO_COLOR=1            Disable terminal colors
EOF
  exit 0
}

ensure_dirs

case "${1:-}" in
  search)   require_yaml && require_registry_helper && cmd_search "${2:-}" ;;
  info)     require_yaml && require_registry_helper && cmd_info "${2:?Usage: csbx info <plugin>}" ;;
  install)
    require_yaml && require_registry_helper && require_non_root_install && acquire_mutation_lock
    shift
    if [[ "${1:-}" == "--caido" ]]; then cmd_caido install "${2:?Usage: csbx install --caido <name>}"
    else cmd_install "${1:?Usage: csbx install <plugin|url>}"; fi
    ;;
  remove)   require_yaml && require_non_root_install && acquire_mutation_lock && cmd_remove "${2:?Usage: csbx remove <plugin>}" ;;
  update)   require_yaml && require_registry_helper && require_non_root_install && acquire_mutation_lock && cmd_update "${2:?Usage: csbx update <plugin|--all>}" ;;
  list)     require_yaml && require_registry_helper && cmd_list "${2:-}" ;;
  sync)     require_registry_helper && acquire_mutation_lock && registry_sync ;;
  pdtm)     require_yaml && require_registry_helper && require_non_root_install && acquire_mutation_lock && cmd_pdtm "${2:?Usage: csbx pdtm <name|manifest.yaml|go-install-path>}" ;;
  plan)     require_yaml && require_registry_helper && shift && cmd_plan "$@" ;;
  verify-plugin)
    require_yaml && require_registry_helper
    [[ "${2:-}" == "--caido" ]] || { err "Usage: csbx verify-plugin --caido <name>"; exit 2; }
    cmd_caido verify "${3:?Usage: csbx verify-plugin --caido <name>}"
    ;;
  verify-image|verify) shift; cmd_verify "$@" ;;
  doctor)   cmd_doctor ;;
  -h|--help|help|"") usage ;;
  *)        err "Unknown command: $1"; usage ;;
esac
